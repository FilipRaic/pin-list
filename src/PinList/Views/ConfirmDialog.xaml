<Window x:Class="PinList.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinList"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource MenuText}">
    <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}"
            BorderThickness="1" CornerRadius="10" Padding="22,20,22,18">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MenuTextMuted}" LineHeight="19"/>
            <!-- Buttons are added from code -->
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PinList"
        x:Class="PinList.ConfirmDialog"
        Title="PinList"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        CanResize="False" ShowInTaskbar="False" Topmost="True"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        FontSize="{DynamicResource T.Body}" Foreground="{DynamicResource Text1}">
    <Panel>
        <LayoutTransformControl x:Name="Scaler">
            <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="{DynamicResource R.Menu}" Padding="22,20,22,18" x:Name="Surface">
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Text3}" LineHeight="19"/>
                    <!-- More below the message (what's new in a version) -->
                    <ContentControl x:Name="Extra" IsVisible="False" Margin="0,12,0,0"/>
                    <!-- Buttons are added from code -->
                    <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </LayoutTransformControl>
        <local:LiveRegion/>
    </Panel>
</Window>

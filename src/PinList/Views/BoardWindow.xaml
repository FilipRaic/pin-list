<Window x:Class="PinList.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinList"
        Title="PinList"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False"
        MinWidth="200" MinHeight="120"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>

        <!-- Round checkbox for completing an item -->
        <ControlTemplate x:Key="CheckTemplate" TargetType="Button">
            <Grid Width="16" Height="16" Background="Transparent">
                <Ellipse x:Name="Circle" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"/>
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Transparent"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Done}"/>
                    <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Done}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCompleting}" Value="True">
                    <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Done}"/>
                    <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Done}"/>
                    <Setter TargetName="Tick" Property="Foreground" Value="White"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource BoardBg}"
            BorderBrush="{DynamicResource BoardBorder}" BorderThickness="1">
        <DockPanel>

            <!-- ===== Header: title + buttons (drag to move) ===== -->
            <Grid DockPanel.Dock="Top" Height="38" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="14,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <TextBox Style="{StaticResource BareTextBox}" FontSize="13" FontWeight="SemiBold"
                             Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVis}}"
                             IsVisibleChanged="EditBox_IsVisibleChanged"
                             KeyDown="EditBox_KeyDown" LostKeyboardFocus="EditBox_LostFocus"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" ToolTip="New category" Click="AddCategory_Click"/>
                    <Button x:Name="LockBtn" Style="{StaticResource IconButton}" Click="Lock_Click"/>
                    <Button x:Name="MenuBtn" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu" Click="Menu_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== Categories ===== -->
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,0,4,6">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Category}">
                                <StackPanel Margin="0,0,0,6">

                                    <!-- Category header -->
                                    <Border x:Name="Header" Padding="6,4" CornerRadius="5" Background="Transparent"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                                            Tag="{Binding}"
                                            PreviewMouseLeftButtonDown="Drag_PreviewMouseDown"
                                            PreviewMouseMove="Drag_PreviewMouseMove"
                                            MouseRightButtonUp="Cat_RightClick"
                                            DragOver="Cat_DragOver" Drop="Cat_Drop">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="1,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="12.5" FontWeight="SemiBold"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                     IsVisibleChanged="EditBox_IsVisibleChanged"
                                                     KeyDown="EditBox_KeyDown" LostKeyboardFocus="EditBox_LostFocus"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Items.Count}" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" Margin="8,0,2,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Width="22" Height="20" FontSize="9" Tag="{Binding}" Click="Collapse_Click"
                                                    ToolTip="Collapse / expand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Content" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Collapsed}" Value="True">
                                                                <Setter Property="Content" Value="&#xE76C;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Items + "Add item" box -->
                                    <StackPanel Visibility="{Binding Collapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:TodoItem}">
                                                    <Border x:Name="Row" Padding="6,4" CornerRadius="5" Background="Transparent"
                                                            BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                                                            Tag="{Binding}"
                                                            PreviewMouseLeftButtonDown="Drag_PreviewMouseDown"
                                                            PreviewMouseMove="Drag_PreviewMouseMove"
                                                            MouseRightButtonUp="Item_RightClick"
                                                            DragOver="Item_DragOver" Drop="Item_Drop">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Template="{StaticResource CheckTemplate}" Tag="{Binding}" Click="Check_Click"
                                                                    Focusable="False" Cursor="Hand" VerticalAlignment="Top" Margin="0,2,10,0"
                                                                    ToolTip="Complete"/>
                                                            <TextBlock x:Name="ItemText" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                                            <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="14"
                                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                                     IsVisibleChanged="EditBox_IsVisibleChanged"
                                                                     PreviewKeyDown="EditBox_KeyDown" LostKeyboardFocus="EditBox_LostFocus"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ActiveBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleting}" Value="True">
                                                            <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Padding="6,4" CornerRadius="5" Background="Transparent"
                                                BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                                                Tag="{Binding}" DragOver="AddRow_DragOver" Drop="AddRow_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{DynamicResource TextMuted}" Margin="2,0,13,0" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="AddBox" Style="{StaticResource BareTextBox}" FontSize="14"
                                                             TextWrapping="Wrap" AcceptsReturn="True"
                                                             ToolTip="Enter adds the item · Shift+Enter starts a new line"
                                                             Tag="{Binding}" PreviewKeyDown="AddBox_KeyDown"/>
                                                    <TextBlock Text="Add item…" Foreground="{DynamicResource TextMuted}"
                                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                                               Visibility="{Binding Text, ElementName=AddBox, Converter={StaticResource EmptyToVis}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Header" Property="Background" Value="{DynamicResource HoverBg}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Header" Property="Background" Value="{DynamicResource ActiveBg}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty space at the bottom: a category can be dropped here -->
                    <Border Height="40" Padding="0,4" Background="Transparent"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="0"
                            DragOver="End_DragOver" Drop="End_Drop"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

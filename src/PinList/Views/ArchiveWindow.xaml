<Window x:Class="PinList.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinList – Archive"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="900" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource ArcBg}" Foreground="{DynamicResource ArcText}">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}">
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ArcText}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource ArcMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid Background="Transparent">
                            <Border BorderBrush="{DynamicResource ArcBorder}" BorderThickness="0,0,0,1" Padding="6,8,6,8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-5,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <Rectangle Width="1" Margin="0,9" Fill="{DynamicResource ArcBorder}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource ArcText}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource InnerFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="0,7" Margin="0,1">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ArcHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ArcSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ArcSelectedText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="Root" Margin="20,16,20,16">

        <!-- Title + search -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Completed items" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" Foreground="{DynamicResource ArcMuted}" Margin="12,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>
            <Grid Grid.Column="1" Width="260">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged"
                         AutomationProperties.Name="Search completed items" AutomationProperties.HelpText="Ctrl+F"/>
                <TextBlock Text="Search" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource ArcMuted}"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}"/>
            </Grid>
        </Grid>

        <!-- Buttons -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" Text="Enter or double-click restores  ·  Del deletes permanently  ·  Ctrl+Z undoes"
                       Foreground="{DynamicResource ArcMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <!-- Shown for a few seconds after restoring, e.g. when an item's category no longer exists -->
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource ArcText}" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource DialogButton}" Content="Delete permanently" Click="Delete_Click"/>
                <Button Style="{StaticResource AccentButton}" Content="Restore" Margin="8,0,0,0" Click="Restore_Click"/>
            </StackPanel>
        </Grid>

        <!-- Table -->
        <Border x:Name="TableBorder" Background="{DynamicResource ArcSurface}" BorderBrush="{DynamicResource ArcBorder}"
                BorderThickness="1" CornerRadius="8" Padding="6,2,6,6">
            <Grid>
                <ListView x:Name="List" SelectionMode="Extended" AutomationProperties.Name="Completed items"
                          AutomationProperties.HelpText="Enter restores, Delete deletes permanently, Ctrl+Z undoes"
                          MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                    <ListView.View>
                        <GridView x:Name="ColumnsView">
                            <GridViewColumn Header="Completed" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding CompletedAt, StringFormat='dd.MM.yyyy  HH:mm'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Item" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding Text, Converter={StaticResource FirstLine}}" ToolTip="{Binding Text}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Category" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{Binding CategoryColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding CategoryName}" ToolTip="{Binding CategoryName}"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Window" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding BoardTitle}" ToolTip="{Binding BoardTitle}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Added" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="Nothing here yet. Completed items show up here with the date and time."
                           Foreground="{DynamicResource ArcMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="20" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>

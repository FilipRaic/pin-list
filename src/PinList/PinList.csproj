<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PinList</RootNamespace>
    <AssemblyName>PinList</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 asks WinForms apps to set DPI awareness in code. This is a WPF app (WinForms is only used for
         the tray icon), and WPF reads DPI awareness from app.manifest, so the manifest setting is correct. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <Version>1.1.1</Version>
    <Product>PinList</Product>
    <Description>To-do list widgets that live on the Windows desktop.</Description>
    <Copyright>Copyright © 2026 Filip Raić</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinList.Tests" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia pieces shared by the desktop app (Windows, macOS) and the phone app (Android). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PinList</RootNamespace>
    <AssemblyName>PinList.UI</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinList.Core\PinList.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinList" />
    <InternalsVisibleTo Include="PinList.Tests" />
  </ItemGroup>

</Project>

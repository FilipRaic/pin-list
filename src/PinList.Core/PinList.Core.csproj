<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that isn't UI: data model, saving, undo, reminders. Shared by every PinList app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PinList</RootNamespace>
    <AssemblyName>PinList.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinList" />
    <InternalsVisibleTo Include="PinList.Tests" />
    <InternalsVisibleTo Include="PinList.Core.Tests" />
  </ItemGroup>

</Project>

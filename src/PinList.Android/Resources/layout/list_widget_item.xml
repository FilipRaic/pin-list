<?xml version="1.0" encoding="utf-8"?>
<!-- An item in the widget's list. The circle completes it, the text opens it in PinList. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="40dp"
              android:orientation="horizontal"
              android:paddingEnd="14dp">

    <ImageView
        android:id="@+id/item_check"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:src="@drawable/widget_ring"/>

    <LinearLayout
        android:id="@+id/item_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textSize="14sp"/>

        <!-- The due date and the reminder mark, shown when the item has either -->
        <LinearLayout
            android:id="@+id/item_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/item_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/item_reminder"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bell"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

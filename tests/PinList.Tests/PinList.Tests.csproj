<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the desktop app. UI tests run the real app on Avalonia's headless platform (no window ever
       shows on the screen). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Coverage counts the app and PinList.UI; PinList.Core is covered by PinList.Core.Tests -->
    <Include>[PinList]*,[PinList.UI]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and Avalonia both have these names; the tests use Avalonia's -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with PinList.Core.Tests: each test gets its own data folder and fresh data -->
    <Compile Include="..\PinList.Core.Tests\TestSetup.cs" Link="TestSetup.cs" />
    <Compile Include="..\PinList.Core.Tests\ManualTimer.cs" Link="ManualTimer.cs" />
    <!-- Fakes for sync: Google sign-in, the cloud folder and HTTP -->
    <Compile Include="..\PinList.Core.Tests\Sync\FakeAuth.cs" Link="Sync\FakeAuth.cs" />
    <Compile Include="..\PinList.Core.Tests\Sync\FakeCloud.cs" Link="Sync\FakeCloud.cs" />
    <Compile Include="..\PinList.Core.Tests\Sync\FakeHttp.cs" Link="Sync\FakeHttp.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PinList\PinList.csproj" />
  </ItemGroup>

</Project>
